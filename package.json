{
  "name": "dsh-pdf-sign",
  "version": "0.1.0",
  "description": "PDF electronic signing for DeepSeek Harness: generate handwritten-style signature images, stamp them onto PDF pages, and apply PKCS#7 digital signatures with your own certificate. · DSH PDF 电子签名插件：生成签名图、PDF 盖章（可视化签名）、自签/自备证书的数字签名。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "license": "MIT",
  "author": "JuntaoXiao",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "pdf",
    "signature",
    "e-signature",
    "digital-signature",
    "pkcs7",
    "stamp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JuntaoXiao/PDF-electronic-signature.git"
  },
  "homepage": "https://github.com/JuntaoXiao/PDF-electronic-signature#readme",
  "bugs": {
    "url": "https://github.com/JuntaoXiao/PDF-electronic-signature/issues"
  },
  "scripts": {
    "test": "node --test tests/"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "pdf-lib": "^1.17.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.1 <0.2.0",
      "profiles": [
        "web",
        "tui",
        "desktop"
      ]
    }
  }
}
